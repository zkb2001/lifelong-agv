*.py[cod]
*.egg-info/
.venv/
venv/

# ML artifacts (regenerate via training scripts)
ml_research/checkpoints/*.pt
# Keep runtime / next-step models for reproducibility
!ml_research/checkpoints/swap_net_v3.pt
!ml_research/checkpoints/escalate_net_v1.pt
!ml_research/checkpoints/escalate_net_map_v1.pt
