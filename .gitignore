!ml_research/checkpoints/wave_net_map_v2.pt
ml_research/checkpoints/archive/
ml_research/data/*.npz

# Results: ignore bulk dumps; keep summaries/figs (must un-ignore dirs first)
ml_research/results/**
!ml_research/results/**/
!ml_research/results/**/*.md
!ml_research/results/**/*.json
!ml_research/results/**/*.png
!ml_research/results/**/*.pdf
ml_research/results/**/trajectories/

# Simulation outputs
data/outputs/trajectories/*.csv
data/outputs/videos/*.mp4

